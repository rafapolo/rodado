# Segredos
.env

# Sistema e editores
.DS_Store

# Ambientes, dependências e caches de ferramenta
.venv/
node_modules/
__pycache__/
.pytest_cache/
.cocoindex_code/

# Dado local — o espelho vive no beelink, não no repo
data/
_rodado_metadata/

# Logs e estado de execução
logs/
*.log
done_tables.txt
done_transfers.txt

# Tarefas e planos — locais, fora do controle de versão desde 2026-09-24
tasks/
tmp/

# Sobras locais do harness, que vive no branch harness-gemma
harness/

# Saídas de scripts/hipoteses_overnight.sh trazidas do beelink — reprodutíveis
# a partir da bateria
.hipoteses/

# Gerados e pesados — regenerar localmente, nunca versionar (purgados do histórico em 2026-09-24)
# schemas.json e rodado-schema.json: gera_schemas.py + sync_mcp_schema.py
docs/context/schemas.json
docs/context/rodado-schema.json
# viz-uf: extrai_estados_cnpj.py + build_br_national.py, ou
#   gh release download viz-uf-dados -D docs/pesquisa/viz-uf/dados
docs/pesquisa/viz-uf/dados/*.bin.gz

# Skills locais — nunca versionar
skills/

# Conhecimento de coleta (fontes, endpoints, contornos de WAF/proxy, macetes de cada scraper) — só local
docs/context/privado/

# Scrapers (endpoints, contornos de WAF/proxy BR, macetes de coleta) — só local desde 2026-10-07,
# tirados também do histórico na mesma data
scripts/scrap/
