# Proxy do db.rodado.xyz no finland: HTTPS fica com o haloy; o acesso é aberto (2026-11-12), a senha
# e o token só destravam POST /q, /index e a cota própria. ttyd e consulta.py rodam no mesmo
# container (inicia.sh) e leem o dado do bucket s3://baseldosdados.
{
	admin off
	auto_https off
	# O haloy (proxy do finland) fica na frente deste Caddy: sem confiar nele, o IP de todo mundo
	# seria o dele e o limite por IP do consulta.py valeria para o mundo inteiro. `strict` lê o
	# X-Forwarded-For da direita para a esquerda e para no primeiro IP fora de private_ranges.
	servers {
		trusted_proxies static private_ranges
		trusted_proxies_strict
	}
}

# Rotas para o app, depois da autenticação (senha ou token).
(app) {
	# `route` fixa a ordem: o token da URL é copiado para o cabeçalho antes de sair dela (o app só
	# usa para dar nome à consulta; quem manda é o Caddy, que apaga o que o cliente enviou). O token
	# nunca chega ao app na URL nem vaza no Referer para as fontes do Google.
	route {
		request_header -X-Rodado-Ip
		request_header -X-Rodado-Token
		request_header X-Rodado-Ip "{client_ip}"
		request_header X-Rodado-Token "{query.token}"
		uri query -token
		header Referrer-Policy "same-origin"
		# /tty/ é o ttyd (terminal, com websocket); /mcp, o servidor MCP; o resto — página com a
		# árvore de datasets, /catalogo.json, /colunas e /query — é o consulta.py.
		handle /tty* {
			reverse_proxy 127.0.0.1:18080 {
				flush_interval -1
			}
		}
		# /mcp é o servidor MCP (streamable HTTP, mcp/mcp_server.py); a consulta dele leva
		# até os 300 s do consulta.py
		handle /mcp* {
			reverse_proxy 127.0.0.1:18082 {
				flush_interval -1
				transport http {
					read_timeout 340s
				}
			}
		}
		handle {
			reverse_proxy 127.0.0.1:18081 {
				transport http {
					read_timeout 320s
				}
			}
		}
	}
}

# Entrada com token: grava o cookie quando o token veio na URL e segue para o app.
(com_token) {
	header @token_na_url {
		>Set-Cookie "rodado_token={http.request.header.X-Rodado-Token}; Path=/; Max-Age=2592000; HttpOnly; Secure; SameSite=Lax"
		Cache-Control "no-store"
	}
	import app
}

:8080 {
	handle /health {
		respond "ok" 200
	}

	# Todo agente que chega aqui (inclusive no 401) recebe o caminho do guia no cabeçalho.
	header Link `</llm>; rel="describedby"; type="text/markdown"`

	# O 401 do basic_auth vinha vazio: um agente sem senha não sabia por onde seguir.
	handle_errors 401 {
		respond <<TXT
			401: este endpoint pede credencial (usuário e senha HTTP Basic, ou ?token=).
			Agentes: o guia público da API está em https://db.rodado.xyz/llm
			TXT 401
	}

	# Robôs de pré-visualização de link recebem só as meta tags (og.html), sem senha:
	# com o 401 eles não leriam o og:title/og:image do index.html.
	@previa {
		path /
		header_regexp User-Agent (?i)(facebookexternalhit|facebot|twitterbot|slackbot|whatsapp|telegrambot|discordbot|linkedinbot|skypeuripreview|redditbot|mastodon|bluesky|cardyb|iframely|embedly|applebot|googlebot|bingbot|signal)
	}
	handle @previa {
		root * /srv
		rewrite * /og.html
		file_server
	}

	# Guia para agentes (/llm, e /llms.txt, o nome que eles procuram): público, sem senha.
	# Só explica a API; os dados continuam atrás da senha ou do token. /robots.txt aponta
	# para ele.
	@guia path /llm /llm.md /llms.txt /.well-known/llms.txt /robots.txt
	handle @guia {
		reverse_proxy 127.0.0.1:18081
	}
	# / pedido como markdown (e não HTML) é um agente: recebe o guia, não o terminal
	@guia_md {
		path /
		header Accept *text/markdown*
		not header Accept *text/html*
	}
	handle @guia_md {
		reverse_proxy 127.0.0.1:18081
	}

	# Link curto /q/<id>: aberto como o resto (2026-11-12). Até então quem abria um link que existe
	# ganhava o cookie do DB_TOKEN_LINK; com o acesso aberto o cookie não dá nada a mais (visitante de
	# link cairia no balde comum e baixo do "link", pior que o do próprio IP), então não se grava mais.

	# Quem tem o token entra sem a senha: ?token=<DB_TOKEN> em qualquer URL (link para
	# terceiros, curl). O primeiro acesso grava o token num cookie HttpOnly, porque o
	# iframe do terminal, o websocket e os fetch da página não levam o ?token. Sem
	# DB_TOKEN no ambiente o token fica desligado (senão "?token=" vazio passaria).
	# Além do DB_TOKEN (o do dono), vale qualquer token de DB_TOKENS (um por pessoa, `nome:token`):
	# inicia.sh exporta DB_TOKENS_RE, a regex ancorada deles (limites.py regex; sem tokens, uma
	# regex que nunca casa). Revogar é tirar da lista e redeployar: o cookie dele também morre.
	# O token do dono (DB_TOKEN) é comparação simples em CEL. Os tokens por pessoa (DB_TOKENS_RE)
	# usam `vars_regexp`, não `.matches()` em CEL: no Caddy 2.10 um ?token ou cookie ausente chega
	# como nulo e `.matches()` dá "no such overload" (500 em toda requisição sem token, até com a
	# senha certa). `vars_regexp` trata o ausente como vazio, e a regex ancorada nunca casa vazio.
	@token_na_url expression `{query.token} != ""`
	@token_dono expression `"{$DB_TOKEN}" != "" && ({query.token} == "{$DB_TOKEN}" || {cookie.rodado_token} == "{$DB_TOKEN}")`
	@token_pessoa_url vars_regexp {http.request.uri.query.token} {$DB_TOKENS_RE:a^}
	@token_pessoa_cookie vars_regexp {http.request.cookie.rodado_token} {$DB_TOKENS_RE:a^}
	# o cookie dado pelo link /q (só pelo cookie: o token de link não vale em ?token=)
	@token_link expression `"{$DB_TOKEN_LINK}" != "" && {cookie.rodado_token} == "{$DB_TOKEN_LINK}"`
	handle @token_dono {
		import com_token
	}
	handle @token_pessoa_url {
		import com_token
	}
	handle @token_pessoa_cookie {
		import com_token
	}
	handle @token_link {
		import com_token
	}

	# Criar link curto (POST /q: grava arquivo no volume e põe o SQL na fila de medição) e listar todos
	# (/index) seguem com senha ou token: custo e disco sem cota por IP.
	@escrita {
		method POST
		path /q /q/
	}
	@indice path /index /index/
	handle @escrita {
		basic_auth {
			{$DB_USUARIO} {$DB_SENHA_HASH}
		}
		import app
	}
	handle @indice {
		basic_auth {
			{$DB_USUARIO} {$DB_SENHA_HASH}
		}
		import app
	}

	# Acesso ABERTO (decisão do dono, 2026-11-12): sem senha nem token, para o terminal, /query e /mcp.
	# A proteção é por IP no app (cota diária, ritmo, recusa de raspagem; limites.py) e a regra do
	# CPF na saída. Quem manda um token pessoal válido (acima) tem a cota dele; o isento do dono
	# (RODADO_ISENTOS) não tem cota. Para voltar a pedir senha: trocar este bloco pelo basic_auth
	# dos dois acima.
	handle {
		import app
	}
}
